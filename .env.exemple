acoustid-key=

# ACRCloud (https://console.acrcloud.com > Audio & Video Recognition > projeto)
acrcloud-host=identify-us-west-2.acrcloud.com
acrcloud-access-key=
acrcloud-access-secret=
# segundos entre envios e maximo de envios por dia
acrcloud-interval=1.5
acrcloud-daily-limit=100

# pastas de trabalho (relativas à pasta do script/executável ou absolutas)
input-dir=Input
temp-dir=Temp
output-dir=Output
